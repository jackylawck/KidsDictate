{
  "name": "kidsdictate",
  "version": "1.0.0",
  "type": "module",
  "description": "Privacy-first offline dictation assistant for primary school kids.",
  "scripts": {
    "dev": "tsc -w & tailwindcss -i ./src/input.css -o ./css/app.css --watch",
    "build": "tsc && tailwindcss -i ./src/input.css -o ./css/app.css --minify",
    "serve": "npx serve ."
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
